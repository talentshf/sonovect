{
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "start",
      "title": "Type",
      "type": "string"
    },
    "sample_rate": {
      "const": 16000,
      "default": 16000,
      "title": "Sample Rate",
      "type": "integer"
    },
    "encoding": {
      "const": "pcm_s16le",
      "default": "pcm_s16le",
      "title": "Encoding",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[\\w-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "hotwords": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Hotwords",
      "type": "array"
    }
  },
  "required": [
    "type"
  ],
  "title": "Start",
  "type": "object"
}
