{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "funasr-result",
  "type": "array",
  "items": {
    "additionalProperties": false,
    "description": "FunASR AutoModel.generate speech-result subset, with optional fields.",
    "properties": {
      "key": {
        "title": "Key",
        "type": "string"
      },
      "text": {
        "title": "Text",
        "type": "string"
      },
      "timestamp": {
        "anyOf": [
          {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Timestamp"
      },
      "sentence_info": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/Sentence"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sentence Info"
      }
    },
    "required": [
      "key",
      "text"
    ],
    "title": "Transcript",
    "type": "object"
  },
  "$defs": {
    "Sentence": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "timestamp": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "spk": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spk"
        }
      },
      "required": [
        "text",
        "start",
        "end"
      ],
      "title": "Sentence",
      "type": "object"
    }
  }
}
