{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audio-analysis",
  "type": "array",
  "items": {
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "audio-analysis-v1",
        "default": "audio-analysis-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "key": {
        "title": "Key",
        "type": "string"
      },
      "status": {
        "enum": [
          "completed",
          "partial",
          "failed",
          "not_requested"
        ],
        "title": "Status",
        "type": "string"
      },
      "stages": {
        "additionalProperties": {
          "$ref": "#/$defs/AnalysisStage"
        },
        "title": "Stages",
        "type": "object"
      },
      "alignment": {
        "anyOf": [
          {
            "$ref": "#/$defs/Alignment"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "classification": {
        "anyOf": [
          {
            "$ref": "#/$defs/Classification"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "understanding": {
        "anyOf": [
          {
            "$ref": "#/$defs/AudioAnswer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "events": {
        "items": {
          "$ref": "#/$defs/Observation"
        },
        "title": "Events",
        "type": "array"
      },
      "emotions": {
        "items": {
          "$ref": "#/$defs/Observation"
        },
        "title": "Emotions",
        "type": "array"
      },
      "voice": {
        "items": {
          "$ref": "#/$defs/Observation"
        },
        "title": "Voice",
        "type": "array"
      },
      "measurements": {
        "items": {
          "$ref": "#/$defs/VoiceMeasurement"
        },
        "title": "Measurements",
        "type": "array"
      },
      "speech_regions": {
        "items": {
          "$ref": "#/$defs/AudioInterval"
        },
        "title": "Speech Regions",
        "type": "array"
      },
      "speaker_turns": {
        "items": {
          "$ref": "#/$defs/SpeakerInterval"
        },
        "title": "Speaker Turns",
        "type": "array"
      },
      "quality": {
        "$ref": "#/$defs/Quality"
      },
      "engines": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/$defs/ModelIdentity"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Engines"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      }
    },
    "required": [
      "key",
      "status"
    ],
    "title": "Analysis",
    "type": "object"
  },
  "$defs": {
    "AlignedWord": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        }
      },
      "required": [
        "text",
        "start_ms",
        "end_ms"
      ],
      "title": "AlignedWord",
      "type": "object"
    },
    "Alignment": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_source": {
          "const": "user",
          "title": "Text Source",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/AlignedWord"
          },
          "title": "Words",
          "type": "array"
        },
        "engine": {
          "$ref": "#/$defs/ModelIdentity"
        }
      },
      "required": [
        "text",
        "text_source",
        "language",
        "words",
        "engine"
      ],
      "title": "Alignment",
      "type": "object"
    },
    "AnalysisStage": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "not_requested"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "status"
      ],
      "title": "AnalysisStage",
      "type": "object"
    },
    "AudioAnswer": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identity_source": {
          "enum": [
            "operator-configuration",
            "engine-response"
          ],
          "title": "Identity Source",
          "type": "string"
        },
        "finish_reason": {
          "default": "stop",
          "enum": [
            "stop",
            "length"
          ],
          "title": "Finish Reason",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        },
        "input": {
          "const": "audio",
          "title": "Input",
          "type": "string"
        },
        "requires_review": {
          "title": "Requires Review",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "model",
        "identity_source",
        "input",
        "requires_review"
      ],
      "title": "AudioAnswer",
      "type": "object"
    },
    "AudioInterval": {
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "AudioInterval",
      "type": "object"
    },
    "ClassScore": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "score"
      ],
      "title": "ClassScore",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "scores": {
          "items": {
            "$ref": "#/$defs/ClassScore"
          },
          "title": "Scores",
          "type": "array"
        },
        "engine": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "aggregation": {
          "title": "Aggregation",
          "type": "string"
        },
        "window_seconds": {
          "title": "Window Seconds",
          "type": "number"
        }
      },
      "required": [
        "scores",
        "engine",
        "aggregation",
        "window_seconds"
      ],
      "title": "Classification",
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "model",
        "revision"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "temporal_resolution": {
          "default": "unspecified",
          "enum": [
            "analysis-window",
            "model-interval",
            "unspecified"
          ],
          "title": "Temporal Resolution",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "label"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "speech_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Ms"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "Quality",
      "type": "object"
    },
    "SpeakerInterval": {
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "SpeakerInterval",
      "type": "object"
    },
    "VoiceMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pitch",
            "relative-energy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "enum": [
            "Hz",
            "dBFS"
          ],
          "title": "Unit",
          "type": "string"
        },
        "method": {
          "enum": [
            "pyin-50-600hz",
            "pcm-rms"
          ],
          "title": "Method",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "temporal_resolution": {
          "const": "analysis-window",
          "default": "analysis-window",
          "title": "Temporal Resolution",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "unit",
        "method",
        "status",
        "start_ms",
        "end_ms"
      ],
      "title": "VoiceMeasurement",
      "type": "object"
    }
  }
}
