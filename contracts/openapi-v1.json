            "default": "audio-analysis-v1"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed",
              "not_requested"
            ],
            "title": "Status"
          },
          "stages": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AnalysisStage"
            },
            "type": "object",
            "title": "Stages"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Events"
          },
          "emotions": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Emotions"
          },
          "voice": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Voice"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/VoiceMeasurement"
            },
            "type": "array",
            "title": "Measurements"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "engines": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/ModelIdentity"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engines"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "status"
        ],
        "title": "Analysis"
      },
      "AnalysisStage": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "not_requested"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AnalysisStage"
      },
      "Body_submit_v1_jobs_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
