  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "audio-analysis-v1",
            "title": "Schema Version",
            "default": "audio-analysis-v1"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed",
              "not_requested"
            ],
            "title": "Status"
          },
          "stages": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AnalysisStage"
            },
            "type": "object",
            "title": "Stages"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Events"
          },
          "emotions": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Emotions"
          },
          "voice": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Voice"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/VoiceMeasurement"
            },
            "type": "array",
            "title": "Measurements"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "engines": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/ModelIdentity"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engines"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "status"
        ],
        "title": "Analysis"
      },
      "AnalysisStage": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "not_requested"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AnalysisStage"
      },
      "Body_submit_v1_jobs_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          },
          "options": {
            "type": "string",
            "maxLength": 20000,
            "title": "Options",
            "default": "{}"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_submit_v1_jobs_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelIdentity": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Model"
          },
          "revision": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "revision"
        ],
        "title": "ModelIdentity"
      },
      "Observation": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "start_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Ms"
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End Ms"
          },
          "temporal_resolution": {
            "type": "string",
            "enum": [
              "analysis-window",
              "model-interval",
              "unspecified"
            ],
            "title": "Temporal Resolution",
            "default": "unspecified"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label"
        ],
        "title": "Observation"
      },
      "Quality": {
        "properties": {
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "speech_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Speech Ms"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Quality"
      },
      "Sentence": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End"
          },
          "timestamp": {
            "anyOf": [
              {
                "items": {
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0.0
                    },
                    {
                      "type": "integer",
                      "minimum": 0.0
                    }
                  ],
                  "type": "array",
                  "maxItems": 2,
                  "minItems": 2
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "spk": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Spk"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "start",
          "end"
        ],
        "title": "Sentence"
      },
      "Transcript": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "timestamp": {
            "anyOf": [
              {
                "items": {
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0.0
                    },
                    {
                      "type": "integer",
                      "minimum": 0.0
                    }
                  ],
                  "type": "array",
                  "maxItems": 2,
                  "minItems": 2
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "sentence_info": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Sentence"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sentence Info"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "text"
        ],
        "title": "Transcript",
        "description": "FunASR AutoModel.generate speech-result subset, with optional fields."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoiceMeasurement": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pitch",
              "relative-energy"
            ],
            "title": "Kind"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "enum": [
              "Hz",
              "dBFS"
            ],
            "title": "Unit"
          },
          "method": {
            "type": "string",
            "enum": [
              "pyin-50-600hz",
              "pcm-rms"
            ],
            "title": "Method"
          },
          "status": {
            "type": "string",
            "enum": [
              "measured",
              "unavailable"
            ],
            "title": "Status"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End Ms"
          },
          "temporal_resolution": {
            "type": "string",
            "const": "analysis-window",
            "title": "Temporal Resolution",
            "default": "analysis-window"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "unit",
          "method",
          "status",
          "start_ms",
          "end_ms"
        ],
        "title": "VoiceMeasurement"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
