        "title": "Issue"
      },
      "ModelIdentity": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Model"
          },
          "revision": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "revision"
        ],
        "title": "ModelIdentity"
      },
      "Observation": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "start_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Ms"
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End Ms"
          },
