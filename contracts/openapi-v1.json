          "schema": {
            "type": "string",
            "const": "sonovect.readiness/v1",
            "title": "Schema",
            "default": "sonovect.readiness/v1"
          },
          "observed_at": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:.+\\-]+Z?$",
            "title": "Observed At"
          },
          "cache_age_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cache Age Ms",
            "default": 0
