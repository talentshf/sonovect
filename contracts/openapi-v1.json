          "options": {
            "type": "string",
            "maxLength": 20000,
            "title": "Options",
            "default": "{}"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_submit_v1_jobs_post"
      },
      "Check": {
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "analysis.events",
              "analysis.measurements",
              "analysis.vocal",
              "queue.database",
              "queue.worker",
              "service",
              "speech.asr",
              "speech.configuration",
              "speech.provider",
              "speech.segmentation"
            ],
            "title": "Component"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "skipped"
            ],
            "title": "Status"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "database_busy",
                  "database_unavailable",
                  "decoder_unavailable",
                  "dependency_failed",
                  "diagnostic_internal_error",
                  "gpu_device_access_denied",
                  "gpu_device_missing",
                  "gpu_driver_library_mismatch",
                  "gpu_nvml_unavailable",
                  "gpu_probe_failed",
                  "gpu_probe_invalid_response",
                  "gpu_probe_timeout",
                  "gpu_probe_tool_missing",
                  "model_load_failed",
                  "not_applicable",
                  "not_configured",
                  "probe_timeout",
                  "provider_configuration_mismatch",
                  "provider_degraded",
                  "provider_http_error",
                  "provider_invalid_response",
                  "provider_timeout",
                  "provider_unreachable",
                  "ready",
                  "service_not_ready",
                  "worker_absent",
                  "worker_backend_mismatch",
                  "worker_stale",
                  "worker_unavailable",
                  "worker_version_mismatch"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "check_container_gpu_access",
                  "check_worker_presence",
                  "check_queue_storage"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "component",
          "required",
          "status"
        ],
        "title": "Check"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Issue": {
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "analysis.events",
              "analysis.measurements",
              "analysis.vocal",
              "queue.database",
              "queue.worker",
              "service",
              "speech.asr",
              "speech.configuration",
              "speech.provider",
              "speech.segmentation"
            ],
            "title": "Component"
          },
          "code": {
            "type": "string",
            "enum": [
              "database_busy",
              "database_unavailable",
              "decoder_unavailable",
              "dependency_failed",
              "diagnostic_internal_error",
              "gpu_device_access_denied",
              "gpu_device_missing",
              "gpu_driver_library_mismatch",
              "gpu_nvml_unavailable",
              "gpu_probe_failed",
              "gpu_probe_invalid_response",
              "gpu_probe_timeout",
              "gpu_probe_tool_missing",
              "model_load_failed",
              "not_applicable",
              "not_configured",
              "probe_timeout",
              "provider_configuration_mismatch",
              "provider_degraded",
              "provider_http_error",
              "provider_invalid_response",
              "provider_timeout",
              "provider_unreachable",
              "ready",
              "service_not_ready",
              "worker_absent",
              "worker_backend_mismatch",
              "worker_stale",
              "worker_unavailable",
              "worker_version_mismatch"
            ],
            "title": "Code"
