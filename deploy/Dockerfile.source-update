# Update application code on an exactly verified release runtime. The caller
# must verify the selected base image IDs and unchanged runtime dependency/OS
# locks before building. The core transport addition below is explicitly pinned;
# other dependency changes require a reviewed runtime build.
ARG CORE_BASE=sonovect-core:0.3.0-0f8214b65dbe
ARG QWEN_BASE=sonovect-qwen:0.3.0-0f8214b65dbe
ARG ANALYSIS_BASE=sonovect-analysis:0.3.0-0f8214b65dbe

FROM ${CORE_BASE} AS package-build
USER root
COPY pyproject.toml README.md LICENSE NOTICE /tmp/sonovect-package/
COPY sonovect /tmp/sonovect-package/sonovect
RUN ["python", "-m", "pip", "wheel", "--no-deps", "--no-build-isolation", "--wheel-dir", "/wheels", "/tmp/sonovect-package"]

FROM ${CORE_BASE} AS core
USER root
COPY deploy/requirements.transport.lock /tmp/requirements.transport.lock
RUN ["python","-m","pip","install","--no-deps","--only-binary=:all:","--require-hashes","-r","/tmp/requirements.transport.lock"]
COPY --from=package-build /wheels/ /tmp/sonovect-wheels/
RUN ["python", "-c", "import glob,subprocess,sys,shutil; subprocess.check_call([sys.executable,'-m','pip','install','--no-index','--no-deps','--force-reinstall',*glob.glob('/tmp/sonovect-wheels/*.whl')]); shutil.rmtree('/tmp/sonovect-wheels'); subprocess.check_call([sys.executable,'-m','pip','check'])"]
ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION
USER 10001:10001

FROM ${QWEN_BASE} AS qwen
USER root
COPY --from=package-build /wheels/ /tmp/sonovect-wheels/
RUN ["python", "-c", "import glob,subprocess,sys,shutil; subprocess.check_call([sys.executable,'-m','pip','install','--no-index','--no-deps','--force-reinstall',*glob.glob('/tmp/sonovect-wheels/*.whl')]); shutil.rmtree('/tmp/sonovect-wheels'); subprocess.check_call([sys.executable,'-m','pip','check'])"]
COPY --chmod=644 providers/speech/qwen-worker/*.py providers/speech/shared/*.py /app/
COPY --chmod=644 sonovect/_version.py /app/sonovect_version.py
COPY --chmod=644 providers/speech/shared/*.py /opt/sonovect/providers/provider/
COPY --chmod=644 providers/speech/shared/*.py /opt/sonovect/providers/asr/
COPY --chmod=644 providers/speech/shared/*.py /opt/sonovect/providers/segmentation/
COPY --chmod=644 providers/speech/api/*.py /opt/sonovect/providers/provider/
COPY --chmod=644 providers/speech/segmentation-worker/*.py /opt/sonovect/providers/segmentation/
COPY --chmod=644 providers/speech/qwen-worker/*.py /opt/sonovect/providers/asr/
COPY --chmod=644 providers/speech/understanding-worker/*.py /opt/sonovect/providers/understanding/
COPY --chmod=644 providers/speech/shared/*.py /opt/sonovect/providers/understanding/
COPY --chmod=644 sonovect/_version.py /opt/sonovect/providers/provider/sonovect_version.py
COPY --chmod=644 sonovect/_version.py /opt/sonovect/providers/segmentation/sonovect_version.py
COPY --chmod=644 sonovect/_version.py /opt/sonovect/providers/asr/sonovect_version.py
RUN ["python", "-c", "import os; from pathlib import Path; root=Path('/opt/sonovect'); root.chmod(0o755); [Path(d).chmod(0o755) for d,_,_ in os.walk(root)]"]
ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION
USER 10001:10001

RUN ["python", "-c", "from pathlib import Path; [p.read_bytes() for p in Path('/opt/sonovect/providers').rglob('*.py')]; Path('/opt/sonovect/providers/understanding/app.py').read_bytes()"]

FROM ${ANALYSIS_BASE} AS analysis
USER root
COPY --from=package-build /wheels/ /tmp/sonovect-wheels/
RUN ["python", "-c", "import glob,subprocess,sys,shutil; subprocess.check_call([sys.executable,'-m','pip','install','--no-index','--no-deps','--force-reinstall',*glob.glob('/tmp/sonovect-wheels/*.whl')]); shutil.rmtree('/tmp/sonovect-wheels'); subprocess.check_call([sys.executable,'-m','pip','check'])"]
COPY --chmod=644 providers/speech/event-worker/*.py /opt/sonovect/providers/events/
COPY --chmod=644 sonovect/_version.py /opt/sonovect/providers/events/sonovect_version.py
COPY --chmod=644 sonovect/_version.py /opt/sonovect/providers/vocal/sonovect_version.py
COPY --chmod=644 sonovect/_version.py /opt/sonovect/providers/measurements/sonovect_version.py
RUN ["python", "-c", "import os; from pathlib import Path; root=Path('/opt/sonovect'); root.chmod(0o755); [Path(d).chmod(0o755) for d,_,_ in os.walk(root)]"]
ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION
USER 10001:10001
RUN ["python", "-c", "from pathlib import Path; [p.read_bytes() for p in Path('/opt/sonovect/providers').rglob('*.py')]"]
