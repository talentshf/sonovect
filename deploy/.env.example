# Prefer sonovect setup --route cpu|qwen --write deploy/.env.
# A generated file prints the matching recipe, selected models and container count.
SONOVECT_TOKEN=change-me
SONOVECT_LAYOUT=compact
SONOVECT_MODELS_OFFLINE=1
SONOVECT_MODEL=paraformer-zh
SONOVECT_MODEL_REVISION=v2.0.4
SONOVECT_MAX_UPLOAD_BYTES=268435456
SONOVECT_MAX_FILES=16
SONOVECT_MAX_MEDIA_SECONDS=7200
SONOVECT_MEDIA_TIMEOUT=300
SONOVECT_INPUT_TTL_HOURS=24
SONOVECT_RESULT_TTL_HOURS=168

# Two base containers. Add profile analysis for any selected CPU analysis.
# Default setup selects AST, not vocals/measurements. Per-job flags stay false.
SONOVECT_SOUND_ENABLED=false
SONOVECT_SOUND_URL=http://analysis:8084
SONOVECT_VOICE_ENABLED=false
SONOVECT_VOICE_BACKEND=moss
SONOVECT_VOICE_URL=http://speech-sound:8083
SONOVECT_MEASUREMENTS_ENABLED=false
SONOVECT_MEASUREMENTS_URL=http://analysis:8086
COMPOSE_PROFILES=
SONOVECT_ANALYSIS_TARGET=analysis-worker
SONOVECT_ANALYSIS_IMAGE=sonovect-analysis
ANALYSIS_CPU_LIMIT=2
ANALYSIS_MEMORY_LIMIT=6g

# setup --sound ast --voice emotion2vec --measurements uses one CPU analysis unit.
# setup --sound none --voice none --measurements selects analysis-measurements,
# image sonovect-analysis-measurements: no model framework and no weights.
# setup --voice 4b|8b adds profile voice; MOSS remains an independent GPU unit.
# setup --layout distributed chooses explicit split-service recipes/profiles.
SONOVECT_VAD_BACKEND=firered
SOUND_EVENT_THRESHOLD=0.1
SOUND_EVENT_TOP_K=5
SOUND_EVENT_WINDOW_SECONDS=10
SOUND_EVENT_THREADS=2
VOCAL_THREADS=2
VOCAL_WINDOW_SECONDS=10
MEASUREMENT_THREADS=2
MEASUREMENT_WINDOW_SECONDS=10
MEASUREMENTS_TIMEOUT_SECONDS=600
