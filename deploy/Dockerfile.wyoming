ARG CORE_BASE=sonovect:0.4.0
FROM ${CORE_BASE}
USER root
COPY deploy/requirements.wyoming.lock /tmp/requirements.wyoming.lock
RUN ["python","-m","pip","install","--no-deps","--only-binary=:all:","--require-hashes","-r","/tmp/requirements.wyoming.lock"]
RUN ["python","-m","pip","check"]
USER 10001:10001
EXPOSE 10300
ENTRYPOINT ["sonovect-wyoming"]
CMD ["--uri","tcp://0.0.0.0:10300"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["python","-c","import socket;s=socket.create_connection(('127.0.0.1',10300),3);s.close()"]
